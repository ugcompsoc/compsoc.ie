# Cloudflare Pages response headers. Without this file every response,
# including content-hashed bundles, is served `max-age=0, must-revalidate`,
# so repeat visits revalidate every script, font and image.

# Vite output: every file directly under /assets/ is content-hashed, so a new
# build always ships new URLs. `:file` matches a single path segment, which
# deliberately excludes the unhashed files under /assets/img/.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are versioned in their filenames (…-v24-…).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
