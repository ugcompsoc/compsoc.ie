{
  "name": "compsoc.ie",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "overrides": {
    "launch-editor": "2.14.1",
    "picomatch": "4.0.5",
    "solid-js": "1.9.14",
    "ws": "8.21.1",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node scripts/sync-events.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format --write && biome check --write --unsafe",
    "lint": "biome lint",
    "check": "biome check",
    "sync:events": "node scripts/sync-events.mjs",
    "deploy": "bun run build && wrangler pages deploy dist/client"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tanstack/devtools-vite": "0.8.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-imagetools": "10.0.1",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
